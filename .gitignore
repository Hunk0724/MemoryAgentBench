# =====================================================
# Tier 3: NEVER push (re-downloadable models, large local caches)
# =====================================================
.cache/
cache/
*.pyc
*.pyo
**/__pycache__/

# =====================================================
# Local-only backup (transient experimental state, 5/12 - v1 iterations)
# =====================================================
.baseline_backup_*/

# =====================================================
# Source-tree noise (already established)
# =====================================================
data
agents
external_repos
process_data
local_data
outputs_4o
outputs_timecompute
raw_dataset
logs
test
mirix_wrapper
system
cognee/.cognee_system/
cognee/.data_storage/
*.db
croissant_files
.env

# =====================================================
# outputs/ — DO track (Tier 1 EM result JSONs + Tier 2 HippoRAG cache)
# but block known noise inside it
# =====================================================
outputs/**/*.tmp
outputs/**/*.log
outputs/**/*.lock
outputs/**/.DS_Store

# =====================================================
# v1 G.11 diagnostic + smoke test runtime artifacts
# (LLM cache + per-run logs are non-deterministic noise)
# =====================================================
monitoring_logs/
outputs/smoke_test_cache/

# =====================================================
# v2.0.2 W1.1+ proposition index (~54 MB per dataset, regenerable
# via analysis/build_proposition_index_w1.py in ~3 min)
# Convert to parquet during W2/I3c KG integration to make tracking practical.
# =====================================================
outputs/**/proposition_index.json
logs/proposition_extraction_sentinels.jsonl

# =====================================================
# 顯式 unblock — keep these out of any wildcard sweeps
# =====================================================
!docs/
!analysis/
!analysis/results/
!analysis/experiments/

# =====================================================
# Migration (2026-06-28): large regenerable artifacts — re-run / re-analyze on
# the new machine. Keep small computed results (analysis/results/phase0 + EM
# result JSONs + figures) so figures reproduce without these.
# =====================================================
# qdrant vector stores (~2 GB) — regenerate by re-ingesting
analysis/results/expanded/
# extraction/triple/grouping caches (regenerable)
analysis/results/p1_caches/
# weak-model regime (gemma3-{1b,4b,12b,27b}) caches — per-model isolated
analysis/results/p1_caches__*/
# weak-model OUTDIRs (results.json from each gemma3 size; reproduction logs are the canonical record)
outputs/**__gemma3-*/
# weak-model resource sampling logs
docs/**/gemma_resource/
# weak-model sp_index per size
analysis/results/phase0/sp_index_*__gemma3-*.json
# per-query retrieved JSONs + LLM caches (~571 MB)
outputs/rag_retrieved/*
# EXCEPT Structure_rag_zep: GX10 path-A (rerun_zep_with_ollama_backbone.py)
# reads Mac's cached edges/nodes/episodes to swap answer LLM without needing
# ZEP_API_KEY. Total ~18 MB (300 files × 3 lengths). See gx10_backbone_gotchas §3.2.
!outputs/rag_retrieved/Structure_rag_zep
# run logs + update_decision.jsonl (~215 MB)
docs/**/logs/
model_cache/
.session_backups/
*.sqlite
*.sqlite.lock

# Local Claude Code settings (deny rules etc.; per-machine, not portable)
.claude/

# scattered regenerable caches at analysis/results root
analysis/results/*_cache_*.json
